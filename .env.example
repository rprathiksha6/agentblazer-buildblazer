# Server Port (Render, Railway, and Fly.io automatically supply PORT)
PORT=5000
NODE_ENV=production

# (Optional) Gmail SMTP Credentials for Real Background Email Sending
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below:
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
